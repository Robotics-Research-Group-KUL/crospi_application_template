    </inertial>
  </link>
  <link name="forearm_link">
    <visual>
      <origin rpy="1.5707963267948966 0.0 -1.5707963267948966" xyz="0.0 0.0 0.0393"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur10e/visual/forearm.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0.0 -1.5707963267948966" xyz="0.0 0.0 0.0393"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur10e/collision/forearm.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="3.989"/>
      <origin rpy="0 0 0" xyz="-0.33155 0.0 0.068"/>
      <inertia ixx="0.01014" ixy="8e-05" ixz="0.00916" iyy="0.30928" iyz="0.0" izz="0.30646"/>
    </inertial>
  </link>
  <link name="wrist_1_link">
    <visual>
      <origin rpy="1.5707963267948966 0.0 0.0" xyz="0.0 0.0 -0.135"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur10e/visual/wrist1.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0.0 0.0" xyz="0.0 0.0 -0.135"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur10e/collision/wrist1.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.1"/>
      <origin rpy="1.570796326794897 0 0" xyz="0.0 -0.018 0.007"/>
      <inertia ixx="0.00296" ixy="-1e-05" ixz="0.0" iyy="0.00222" iyz="-0.00024" izz="0.00258"/>
    </inertial>
  </link>
  <link name="wrist_2_link">
    <visual>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.12"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur10e/visual/wrist2.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.12"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur10e/collision/wrist2.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.98"/>
      <origin rpy="-1.570796326794897 0 0" xyz="0.0 0.018 -0.007"/>
      <inertia ixx="0.00296" ixy="-1e-05" ixz="0.0" iyy="0.00222" iyz="-0.00024" izz="0.00258"/>
    </inertial>
  </link>
  <link name="wrist_3_link">
    <visual>
      <origin rpy="1.5707963267948966 0.0 0.0" xyz="0.0 -0.0005 -0.1168"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur10e/visual/wrist3.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0.0 0.0" xyz="0.0 -0.0005 -0.1168"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur10e/collision/wrist3.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.615"/>
      <origin rpy="0 0 0" xyz="0.0 0.0 -0.026"/>
      <inertia ixx="0.0004" ixy="0.0" ixz="0.0" iyy="0.00041" iyz="0.0" izz="0.00034"/>
    </inertial>
  </link>
  <!-- base_joint fixes base_link to the environment -->
  <joint name="base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="world"/>
    <child link="base_link"/>
  </joint>
  <!-- joints - main serial chain -->
  <joint name="base_link-base_link_inertia" type="fixed">
    <parent link="base_link"/>
    <child link="base_link_inertia"/>
    <!-- 'base_link' is REP-103 aligned (so X+ forward), while the internal
           frames of the robot/controller have X+ pointing backwards.
           Use the joint between 'base_link' and 'base_link_inertia' (a dummy
           link/frame) to introduce the necessary rotation over Z (of pi rad).
      -->
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
  </joint>
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link_inertia"/>
    <child link="shoulder_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.1807"/>
    <axis xyz="0 0 1"/>
    <limit effort="330.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="2.0943951023931953"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin rpy="1.570796327 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="330.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="2.0943951023931953"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin rpy="0 0 0" xyz="-0.6127 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="150.0" lower="-3.141592653589793" upper="3.141592653589793" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin rpy="0 0 0" xyz="-0.57155 0 0.17415"/>
    <axis xyz="0 0 1"/>
    <limit effort="54.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin rpy="1.570796327 0 0" xyz="0 -0.11985 -2.458164590756244e-11"/>
    <axis xyz="0 0 1"/>
    <limit effort="54.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin rpy="1.570796326589793 3.141592653589793 3.141592653589793" xyz="0 0.11655 -2.390480459346185e-11"/>
    <axis xyz="0 0 1"/>
    <limit effort="54.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <link name="ft_frame"/>
  <joint name="wrist_3_link-ft_frame" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="ft_frame"/>
    <origin rpy="3.141592653589793 0 0" xyz="0 0 0"/>
  </joint>
  <!-- ROS-Industrial 'base' frame - base_link to UR 'Base' Coordinates transform -->
  <link name="base"/>
  <joint name="base_link-base_fixed_joint" type="fixed">
    <!-- Note the rotation over Z of pi radians - as base_link is REP-103
           aligned (i.e., has X+ forward, Y+ left and Z+ up), this is needed
           to correctly align 'base' with the 'Base' coordinate system of
           the UR controller.
      -->
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
    <parent link="base_link"/>
    <child link="base"/>
  </joint>
  <!-- ROS-Industrial 'flange' frame - attachment point for EEF models -->
  <link name="flange"/>
  <joint name="wrist_3-flange" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="flange"/>
    <origin rpy="0 -1.5707963267948966 -1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <!-- ROS-Industrial 'tool0' frame - all-zeros tool frame -->
  <link name="tool0"/>
  <joint name="flange-tool0" type="fixed">
    <!-- default toolframe - X+ left, Y+ up, Z+ front -->
    <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0 0 0"/>
    <parent link="flange"/>
    <child link="tool0"/>
  </joint>
  <!-- ==================================================================================================
       Generic parallel gripper (added for the Crospi Playground): coupling, housing and two parallel fingers on
       prismatic joints, 0 to 85 mm of opening. Boxes and a cylinder (no meshes). Each finger joint gives the position of the inner face of its pad from the center (0: closed, 0.0425:
       open); right_finger_joint mimics left_finger_joint (one actuator: the fingers move symmetrically). tool_tip is
       the center of the bottom of the pads, 0.15 m from tool0 along its z axis (same orientation as tool0).
       Driven by the simulator of the Crospi Playground ("gripper" of the MuJoCo simulator in the setup).
       =================================================================================================== -->
  <material name="gripper_black">
    <color rgba="0.12 0.12 0.13 1"/>
  </material>
  <material name="gripper_pad">
    <color rgba="0.35 0.35 0.37 1"/>
  </material>
  <link name="gripper_coupling">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.007"/>
      <mass value="0.1"/>
      <inertia ixx="3.68e-05" ixy="0" ixz="0" iyy="3.68e-05" iyz="0" izz="7.03e-05"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.007"/>
      <geometry>
        <cylinder length="0.014" radius="0.0375"/>
      </geometry>
      <material name="gripper_black"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.007"/>
      <geometry>
        <cylinder length="0.014" radius="0.0375"/>
      </geometry>
    </collision>
  </link>
  <joint name="tool0-gripper_coupling" type="fixed">
    <parent link="tool0"/>
    <child link="gripper_coupling"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="gripper_base">
    <inertial>
      <origin rpy="0 0 0" xyz="0.0000 0 0.0350"/>
      <mass value="0.65"/>
      <inertia ixx="4.9427e-04" ixy="0" ixz="0" iyy="7.0417e-04" iyz="0" izz="6.6760e-04"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0.0000 0.0000 0.0350"/>
      <geometry>
        <box size="0.0900 0.0650 0.0700"/>
      </geometry>
      <material name="gripper_black"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0.0000 0.0000 0.0350"/>
      <geometry>
        <box size="0.0900 0.0650 0.0700"/>
      </geometry>
    </collision>
  </link>
  <joint name="gripper_coupling-gripper_base" type="fixed">
    <parent link="gripper_coupling"/>
    <child link="gripper_base"/>
    <origin rpy="0 0 0" xyz="0 0 0.014"/>
  </joint>
  <link name="left_finger">
    <inertial>
      <origin rpy="0 0 0" xyz="0.0090 0 0.0353"/>
      <mass value="0.08"/>
      <inertia ixx="3.6362e-05" ixy="0" ixz="0" iyy="3.6362e-05" iyz="0" izz="6.4533e-06"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0.0140 0.0000 0.0220"/>
      <geometry>
        <box size="0.0120 0.0220 0.0440"/>
      </geometry>
      <material name="gripper_pad"/>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0.0040 0.0000 0.0485"/>
      <geometry>
        <box size="0.0080 0.0220 0.0350"/>
      </geometry>
      <material name="gripper_pad"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0.0140 0.0000 0.0220"/>
      <geometry>
        <box size="0.0120 0.0220 0.0440"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="0.0040 0.0000 0.0485"/>
      <geometry>
        <box size="0.0080 0.0220 0.0350"/>
      </geometry>
    </collision>
  </link>
  <joint name="left_finger_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="left_finger"/>
    <origin rpy="0 0 0" xyz="0 0 0.07"/>
    <axis xyz="1 0 0"/>
    <limit effort="235.0" lower="0.0" upper="0.0425" velocity="0.15"/>
  </joint>
  <link name="right_finger">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.0090 0 0.0353"/>
      <mass value="0.08"/>
      <inertia ixx="3.6362e-05" ixy="0" ixz="0" iyy="3.6362e-05" iyz="0" izz="6.4533e-06"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="-0.0140 0.0000 0.0220"/>
      <geometry>
        <box size="0.0120 0.0220 0.0440"/>
      </geometry>
      <material name="gripper_pad"/>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="-0.0040 0.0000 0.0485"/>
      <geometry>
        <box size="0.0080 0.0220 0.0350"/>
      </geometry>
      <material name="gripper_pad"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="-0.0140 0.0000 0.0220"/>
      <geometry>
        <box size="0.0120 0.0220 0.0440"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="-0.0040 0.0000 0.0485"/>
      <geometry>
        <box size="0.0080 0.0220 0.0350"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_finger_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="right_finger"/>
    <origin rpy="0 0 0" xyz="0 0 0.07"/>
    <axis xyz="-1 0 0"/>
    <limit effort="235.0" lower="0.0" upper="0.0425" velocity="0.15"/>
    <mimic joint="left_finger_joint" multiplier="1" offset="0"/>
  </joint>
  <link name="tool_tip"/>
  <joint name="tool0-tool_tip" type="fixed">
    <parent link="tool0"/>
    <child link="tool_tip"/>
    <origin rpy="0 0 0" xyz="0 0 0.15"/>
  </joint>
</robot>
