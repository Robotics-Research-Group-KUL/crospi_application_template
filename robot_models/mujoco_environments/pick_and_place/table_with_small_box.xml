<!--
  Pick and place with a small robot gripper (Franka Emika Panda, Trossen WidowX AI) for mujoco_robotsimulator_crospi:
  the table of table_with_box.xml (top surface at z = 0.4 m), a free cube of 5 cm (0.15 kg: it fits the grippers of
  both robots, 80 mm and 88 mm of maximal opening) and a pedestal for the robot, whose top is at z = 0.45 m.

  Setups (applications/application_mujoco_examples_<robot>/<robot>_pick_and_place.setup.json): the robot stands on
  the pedestal, base_position = (0.3, -0.4, 0.45), and faces the table (base_quaternion_xyzw = rotation of -90 deg about
  z: its x axis points along -y of the world). In the robot base frame: the table top is at z = -0.05, the cube at
  (0.40, 0, -0.025) and the drop target at (0.35, 0.15, -0.05). (A robot with a vertical gripper reaches the table more
  easily from above it: the WidowX AI can point its gripper down only up to about 0.15 m above its base.)

  The physics options (timestep, gravity, integrator, contacts) of this file are overwritten by the crospi
  configuration of the simulator.
-->
<mujoco model="table_with_small_box">
  <compiler angle="radian"/>
  <!-- Grasping: elliptic friction cones and a high impratio (friction-to-normal impedance) so that the cube does not
       slip slowly out of the gripper (soft contacts creep under a constant load with the default pyramidal cones) -->
  <option cone="elliptic" impratio="10"/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.2 0.3 0.4" rgb2="0.3 0.4 0.5" width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="4 4" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light name="top" pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="grid"/>

    <!-- Table next to the robot (negative y side), top surface at z = 0.4 m -->
    <body name="table" pos="0.3 -1.0 0.2">
      <geom name="table_top" type="box" size="0.3 0.5 0.2" rgba="0.55 0.4 0.3 1"/>
      <!-- Volume of the touch sensor: contacts on the top surface of the table -->
      <site name="table_top_surface" type="box" pos="0 0 0.2" size="0.3 0.5 0.01" rgba="0 0 0 0" group="4"/>
      <!-- Drop target (visual only: no contacts), at (0.45, -0.75) on the table top -->
      <geom name="drop_target" type="cylinder" pos="0.15 0.25 0.2005" size="0.035 0.0005" rgba="0.35 0.65 0.35 1"
            contype="0" conaffinity="0"/>
    </body>

    <!-- Pedestal of the robot: top at z = 0.45 m (the robot base is attached there by the setup) -->
    <body name="pedestal" pos="0.3 -0.4 0.225">
      <geom name="pedestal" type="box" size="0.08 0.08 0.225" rgba="0.35 0.35 0.38 1"/>
    </body>

    <!-- Free cube lying on the table, 5 cm -->
    <body name="box" pos="0.3 -0.8 0.425">
      <freejoint name="box_joint"/>
      <geom name="box" type="box" size="0.025 0.025 0.025" mass="0.15" rgba="0.8 0.2 0.2 1"/>
    </body>
  </worldbody>

  <!-- MuJoCo sensors: published by the simulator on <topic_namespace>/mujoco_sensors/<name> -->
  <sensor>
    <framepos name="box_position" objtype="body" objname="box"/>
    <framequat name="box_orientation" objtype="body" objname="box"/>
    <touch name="table_top_touch" site="table_top_surface"/>
  </sensor>
</mujoco>
