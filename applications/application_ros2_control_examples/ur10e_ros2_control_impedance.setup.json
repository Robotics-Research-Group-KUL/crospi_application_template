{
    "$schema": "../../schemas/generated/blackboard-schema-bundled.json",
    "blackboard": {
        "etasl": {
            "general": {
                "event_topic": "crospi_node/events",
                "sample_time": 0.01
            },
            "initializer": {
                "full": true,
                "sample_time": 0.01,
                "duration": 3.0,
                "convergence_criterion": 1e-08,
                "weightfactor": 10000.0
            },
            "solver": {
                "is-qpoasessolver": true,
                "nWSR": 100,
                "regularization_factor": 1e-08,
                "cputime": 10
            }
        },
        "robot": {
            "robotsimulators": [
                {
                    "is-ros2_control": true,
                    "robot_joints": [
                        "shoulder_pan_joint",
                        "shoulder_lift_joint",
                        "elbow_joint",
                        "wrist_1_joint",
                        "wrist_2_joint",
                        "wrist_3_joint"
                    ],
                    "periodicity": 0.002,
                    "robot_description": {
                        "file": "$[ur_robot_driver]/urdf/ur.urdf.xacro",
                        "xacro_arguments": {
                            "name": "ur",
                            "ur_type": "ur10e",
                            "use_mock_hardware": true,
                            "mock_sensor_commands": false
                        }
                    },
                    "controllers": [
                        {
                            "name": "joint_state_broadcaster",
                            "type": "joint_state_broadcaster/JointStateBroadcaster",
                            "parameters": {
                                "use_local_topics": true
                            }
                        },
                        {
                            "name": "pid_controller",
                            "type": "pid_controller/PidController",
                            "parameters": {
                                "dof_names": [
                                    "shoulder_pan_joint",
                                    "shoulder_lift_joint",
                                    "elbow_joint",
                                    "wrist_1_joint",
                                    "wrist_2_joint",
                                    "wrist_3_joint"
                                ],
                                "command_interface": "velocity",
                                "reference_and_state_interfaces": [
                                    "position",
                                    "velocity"
                                ],
                                "gains": {
                                    "shoulder_pan_joint": {
                                        "p": 10.0,
                                        "i": 0.0,
                                        "d": 0.0,
                                        "feedforward_gain": 1.0
                                    },
                                    "shoulder_lift_joint": {
                                        "p": 10.0,
                                        "i": 0.0,
                                        "d": 0.0,
                                        "feedforward_gain": 1.0
                                    },
                                    "elbow_joint": {
                                        "p": 10.0,
                                        "i": 0.0,
                                        "d": 0.0,
                                        "feedforward_gain": 1.0
                                    },
                                    "wrist_1_joint": {
                                        "p": 10.0,
                                        "i": 0.0,
                                        "d": 0.0,
                                        "feedforward_gain": 1.0
                                    },
                                    "wrist_2_joint": {
                                        "p": 10.0,
                                        "i": 0.0,
                                        "d": 0.0,
                                        "feedforward_gain": 1.0
                                    },
                                    "wrist_3_joint": {
                                        "p": 10.0,
                                        "i": 0.0,
                                        "d": 0.0,
                                        "feedforward_gain": 1.0
                                    }
                                }
                            }
                        }
                    ],
                    "command_interfaces": [
                        "position",
                        "velocity"
                    ],
                    "name_expr_joint_vel": "joint_vel",
                    "name_expr_joint_torque": "joint_torque",
                    "chained_controller": "pid_controller"
                }
            ],
            "robotdrivers": [
                {
                    "is-ros2_control": true,
                    "robot_joints": [
                        "shoulder_pan_joint",
                        "shoulder_lift_joint",
                        "elbow_joint",
                        "wrist_1_joint",
                        "wrist_2_joint",
                        "wrist_3_joint"
                    ],
                    "periodicity": 0.002,
                    "robot_description": {
                        "file": "$[ur_robot_driver]/urdf/ur.urdf.xacro",
                        "xacro_arguments": {
                            "name": "ur",
                            "ur_type": "ur10e",
                            "robot_ip": "192.168.56.102",
                            "headless_mode": true,
                            "script_filename": "$[ur_client_library]/resources/external_control.urscript",
                            "input_recipe_filename": "$[ur_robot_driver]/resources/rtde_input_recipe.txt",
                            "output_recipe_filename": "$[ur_robot_driver]/resources/rtde_output_recipe.txt"
                        }
                    },
                    "controllers": [
                        {
                            "name": "joint_state_broadcaster",
                            "type": "joint_state_broadcaster/JointStateBroadcaster",
                            "parameters": {
                                "use_local_topics": true
                            }
                        },
                        {
                            "name": "force_torque_sensor_broadcaster",
                            "type": "force_torque_sensor_broadcaster/ForceTorqueSensorBroadcaster",
                            "parameters": {
                                "sensor_name": "tcp_fts_sensor",
                                "frame_id": "tool0"
                            }
                        },
                        {
                            "name": "pid_controller",
                            "type": "pid_controller/PidController",
                            "parameters": {
                                "dof_names": [
                                    "shoulder_pan_joint",
                                    "shoulder_lift_joint",
                                    "elbow_joint",
                                    "wrist_1_joint",
                                    "wrist_2_joint",
                                    "wrist_3_joint"
                                ],
                                "command_interface": "effort",
                                "reference_and_state_interfaces": [
                                    "position",
                                    "velocity"
                                ],
                                "gains": {
                                    "shoulder_pan_joint": {
                                        "p": 400.0,
                                        "i": 0.0,
                                        "d": 40.0,
                                        "feedforward_gain": 0.0
                                    },
                                    "shoulder_lift_joint": {
                                        "p": 400.0,
                                        "i": 0.0,
                                        "d": 40.0,
                                        "feedforward_gain": 0.0
                                    },
                                    "elbow_joint": {
                                        "p": 300.0,
                                        "i": 0.0,
                                        "d": 30.0,
                                        "feedforward_gain": 0.0
                                    },
                                    "wrist_1_joint": {
                                        "p": 100.0,
                                        "i": 0.0,
                                        "d": 10.0,
                                        "feedforward_gain": 0.0
                                    },
                                    "wrist_2_joint": {
                                        "p": 100.0,
                                        "i": 0.0,
                                        "d": 10.0,
                                        "feedforward_gain": 0.0
                                    },
                                    "wrist_3_joint": {
                                        "p": 50.0,
                                        "i": 0.0,
                                        "d": 5.0,
                                        "feedforward_gain": 0.0
                                    }
                                }
                            }
                        }
                    ],
                    "command_interfaces": [
                        "position",
                        "velocity"
                    ],
                    "name_expr_joint_vel": "joint_vel",
                    "name_expr_joint_torque": "joint_torque",
                    "wrench_sensor": "tcp_fts_sensor",
                    "name_expr_cartesian_wrench": "task_frame_wrench",
                    "chained_controller": "pid_controller"
                }
            ],
            "default_robot_specification": {
                "is-inline_robotspecification": true,
                "urdf_path": "$[crospi_application_template]/robot_models/urdf_models/robot_setups/ur10e/use_case_setup_ur10e.urdf",
                "tcp_frame": {
                    "child_link": "tool0",
                    "parent_link": "base_link"
                },
                "additional_frames": [
                    {
                        "name": "FT_sensor_frame",
                        "child_link": "tool0",
                        "parent_link": "base_link"
                    }
                ],
                "robot_joints": [
                    "shoulder_pan_joint",
                    "shoulder_lift_joint",
                    "elbow_joint",
                    "wrist_1_joint",
                    "wrist_2_joint",
                    "wrist_3_joint"
                ]
            }
        },
        "iohandlers": {
            "outputhandlers": [
                {
                    "is-JointStateOutputHandler": true,
                    "topic-name": "/joint_states"
                }
            ],
            "inputhandlers": []
        }
    },
    "$defs": {}
}
