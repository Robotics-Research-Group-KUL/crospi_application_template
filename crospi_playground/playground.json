                        },
                        {
                            "setup": "applications/application_mujoco_examples_ur10e/ur10e_gripper_pick_and_place.setup.json",
                            "tasks": "skill_specifications/libraries/skill_lib_example/pick_and_place/pick_and_place.ur10e_gripper.json"
                        }
                    ]
