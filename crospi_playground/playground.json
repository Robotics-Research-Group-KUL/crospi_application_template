                        },
                        {
                            "setup": "applications/application_mujoco_examples_widowx_ai/widowx_ai_joystick.setup.json",
                            "tasks": "skill_specifications/libraries/skill_lib_example/joystick_teleoperation/joystick_teleoperation.widowx_ai.json"
                        }
                    ],
                    "description": "Move home, then move_joystick. Switch the SpaceMouse on (3D view): the TwistInputHandler of the setup feeds /spacenav/twist to joystick_input."
                }
            ]
        },
        {
            "group": "Markers",
            "items": [
                {
                    "id": "markers_waypoints",
                    "title": "Markers: waypoints (BeTFSM blocks)",
                    "script": "skill_specifications/libraries/skill_lib_example/markers_waypoints/markers_waypoints.py",
                    "setups": [
                        {"setup": "applications/application_mujoco_examples_ur10e/ur10e_position_servo.setup.json"}
                    ],
                    "description": "Markers changed by the skill (crospi_playground): plan as paths, target per waypoint, pins, countdown, blinking. Sequence, Compute, Repeat, CrospiTask with a parameter callback, Concurrent + TimedWait, TimedRepeat; MarkerEdit, WithMarkers, MarkerUpdater."
                },
                {
                    "id": "markers_corner",
                    "title": "Markers: corner localization (BeTFSM blocks)",
                    "script": "skill_specifications/libraries/skill_lib_example/markers_corner/markers_corner.py",
                    "setups": [
                        {"setup": "applications/application_mujoco_examples_ur10e/ur10e_guarded_motions.setup.json"}
                    ],
                    "description": "Guarded motions to the corner on the table with markers: force arrow, contact pins, estimated corner vs ground truth. Fallback, While, Adapt, AlwaysOutcome, Concurrent, ConcurrentSequence, LogBlackboard; a ConfigCallback on /forces_etasl."
                }
            ]
        },
        {
            "group": "Pick and place with a gripper",
            "items": [
                {
                    "id": "pick_and_place_simple",
                    "title": "Pick and place (simple)",
                    "description": "A cube (a free body of the simulation) moved to a target on the table with the gripper, in a fixed sequence: motions to known poses (move_cartesianspace_absolute_pose; the poses in the task list of the robot), the gripper opened and closed by BeTFSM states (fake_gripper_control.py; simulation only) over ROS 2 topics, not by eTaSL. No guarded motions, no markers, the grasp is not checked (see Pick and place (advanced)). Franka Emika Panda, Trossen WidowX AI or UR10e with a parallel gripper (Setup dropdown of the Setup tab).",
                    "script": "skill_specifications/libraries/skill_lib_example/pick_and_place/pick_and_place_simple.py",
                    "setups": [
                        {"setup": "applications/application_mujoco_examples_franka_panda/franka_panda_pick_and_place.setup.json"},
                        {
                            "setup": "applications/application_mujoco_examples_widowx_ai/widowx_ai_pick_and_place.setup.json",
                            "tasks": "skill_specifications/libraries/skill_lib_example/pick_and_place/pick_and_place_simple.widowx_ai.json"
                        },
                        {
                            "setup": "applications/application_mujoco_examples_ur10e/ur10e_gripper_pick_and_place.setup.json",
                            "tasks": "skill_specifications/libraries/skill_lib_example/pick_and_place/pick_and_place_simple.ur10e_gripper.json"
                        }
                    ]
                },
                {
                    "id": "pick_and_place",
                    "title": "Pick and place (advanced)",
                    "description": "A cube (a free body of the simulation) moved to a target on the table: fast motions to an absolute pose (move_cartesianspace_absolute_pose) until 2 cm above the table, then guarded motions find the table when picking and when placing; the simulated gripper is commanded by BeTFSM states (fake_gripper_control.py: GripperOpen, GripperClose; simulation only) over ROS 2 topics, not by eTaSL; without a cube, the gripper closes completely and the skill ends with NO_OBJECT. Franka Emika Panda, Trossen WidowX AI or UR10e with a parallel gripper (Setup dropdown of the Setup tab).",
                    "script": "skill_specifications/libraries/skill_lib_example/pick_and_place/pick_and_place.py",
                    "setups": [
                        {"setup": "applications/application_mujoco_examples_franka_panda/franka_panda_pick_and_place.setup.json"},
                        {
                            "setup": "applications/application_mujoco_examples_widowx_ai/widowx_ai_pick_and_place.setup.json",
