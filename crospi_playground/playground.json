{
    "$schema": "playground.schema.json",
    "description": "Content of the Crospi Playground for this application package (examples of the Task and Skill modes). Paths are relative to the package directory.",
    "default_task_example": "joint_move",
    "default_skill_example": "guarded",
    "task_examples": [
        {
            "group": "Getting started (plain eTaSL)",
            "items": [
                {
                    "id": "joint_move",
                    "title": "Hello eTaSL: move in joint space",
                    "description": "Each joint is driven to a target with a first-order behaviour; a monitor finishes the task.",
                    "task": "crospi_playground/task_examples/joint_move.lua",
                    "setup": "applications/application_mujoco_examples_ur10e/ur10e_empty_ready.setup.json",
                    "reset": true
                },
                {
                    "id": "circle",
                    "title": "Draw a circle with the tool tip",
                    "description": "Cartesian position constraint that follows a time-dependent circle, constant orientation.",
                    "task": "crospi_playground/task_examples/cartesian_circle.lua",
                    "setup": "applications/application_mujoco_examples_ur10e/ur10e_empty_above_table.setup.json",
                    "reset": true
                },
                {
                    "id": "hand_guiding",
                    "title": "Hand guiding: move_admittance (force_control_task_lib)",
                    "description": "Admittance control with the F/T sensor: pull the tool (Ctrl + right-drag) or twist it (Ctrl + left-drag) in the 3D view and it follows. wrench_convention = exerted_on_environment: the sign convention of the simulated sensor.",
                    "task": "task_specifications/libraries/force_control_task_lib/task_specifications/move_admittance.etasl.lua",
                    "params": {
                        "K_t": 1000,
                        "K_r": 50,
                        "task_frame": "tcp_frame",
                        "FT_sensor_frame": "FT_sensor_frame",
                        "wrench_convention": "exerted_on_environment",
                        "activate_linear": true,
                        "activate_angular": true,
                        "force_threshold": 0.5,
                        "torque_threshold": 0.05,
                        "tool_weight": 0,
                        "tool_COG": [0, 0, 0]
                    },
                    "setup": "applications/application_mujoco_examples_ur10e/ur10e_empty_above_table.setup.json",
                    "reset": true
                },
                {
                    "id": "force_plain",
                    "title": "Push on the table with 5 N",
                    "description": "Force control with the simulated force/torque sensor (input channel \"wrench_input\").",
                    "task": "crospi_playground/task_examples/force_plain.lua",
                    "setup": "applications/application_mujoco_examples_ur10e/ur10e_corner_above_table.setup.json",
                    "reset": true
                }
            ]
        },
        {
            "group": "crospi task libraries",
            "items": [
                {
                    "id": "trap",
                    "title": "move_jointspace_trap (core_task_lib)",
                    "description": "Joint motion with a trapezoidal velocity profile.",
                    "task": "task_specifications/libraries/core_task_lib/task_specifications/move_jointspace_trap.etasl.lua",
                    "params": {
                        "maxvel": 0.5,
                        "maxacc": 0.5,
                        "target_joints": [-90, -60, 90, -120, -90, 0],
                        "units": "degrees"
                    },
                    "setup": "applications/application_mujoco_examples_ur10e/ur10e_empty_above_table.setup.json"
                },
                {
                    "id": "cart_rel",
                    "title": "move_cartesianspace_relative (core_task_lib)",
                    "description": "Relative Cartesian motion of the tool with a trapezoidal profile.",
                    "task": "task_specifications/libraries/core_task_lib/task_specifications/move_cartesianspace_relative.etasl.lua",
                    "params": {
                        "delta_pos": [0.1, 0, -0.05],
                        "delta_euler": [0, 0, 0],
                        "wrt_frame": "world_frame",
                        "maxvel": 0.1,
                        "maxacc": 0.1,
                        "task_frame": "tcp_frame",
                        "eq_r": 0.08,
                        "error_pos_th": 0.001,
                        "error_rot_th": 0.01
                    },
                    "setup": "applications/application_mujoco_examples_ur10e/ur10e_empty_above_table.setup.json"
                },
                {
                    "id": "cart_abs",
                    "title": "move_cartesianspace_absolute_pose (core_task_lib)",
                    "description": "Cartesian motion of the tool to an absolute pose (position and quaternion [x, y, z, qx, qy, qz, qw] in the robot base frame) with a trapezoidal profile: here 0.175 m along x, 4 cm lower and turned by 45 deg about the vertical.",
                    "task": "task_specifications/libraries/core_task_lib/task_specifications/move_cartesianspace_absolute_pose.etasl.lua",
                    "params": {
                        "desired_pose": [0.35, -0.6, 0.2, 0.38268, -0.92388, 0, 0],
                        "maxvel": 0.1,
                        "maxacc": 0.1,
                        "task_frame": "tcp_frame",
                        "eq_r": 0.08,
                        "error_pos_th": 0.001,
                        "error_rot_th": 0.01
                    },
                    "setup": "applications/application_mujoco_examples_ur10e/ur10e_empty_above_table.setup.json"
                },
                {
                    "id": "joystick",
                    "title": "move_joystick (core_task_lib): SpaceMouse",
                    "description": "Moves the tool with the emulated SpaceMouse: switch it on in the 3D view; it reaches joystick_input through the TwistInputHandler of the Settings. Right-drag: move, left-drag: rotate. Runs until stopped.",
                    "task": "task_specifications/libraries/core_task_lib/task_specifications/move_joystick.etasl.lua",
                    "params": {
                        "linear_scale": 0.1,
                        "angular_scale": 0.5,
                        "task_frame": "tcp_frame",
                        "activate_linear": true,
                        "activate_angular": true,
                        "execution_time": 0
                    },
                    "setup": "applications/application_mujoco_examples_ur10e/ur10e_corner_above_table.setup.json",
                    "reset": true
                },
                {
                    "id": "guarded",
                    "title": "guarded_motion (force_control_task_lib)",
                    "description": "Moves down until contact with the table (force monitor).",
                    "task": "task_specifications/libraries/force_control_task_lib/task_specifications/guarded_motion.etasl.lua",
                    "params": {
                        "force_threshold": 0.5,
                        "torque_threshold": 0.05,
                        "contact_forces": [0, 0, 3],
                        "force_monitor": 1,
                        "axis": "z",
                        "FT_sensor_frame": "FT_sensor_frame",
                        "guarded_motion_frame": "world_frame",
                        "K_F": [1500, 1500, 1500],
                        "K_T": [200, 200, 200],
                        "maxvel": 0.5,
                        "task_frame": "tcp_frame",
                        "tf_2_insframe": [0, 0, 0, 0, 0, 0, 1],
                        "time_delay": 2,
                        "tool_COG": [0, 0, 0],
                        "tool_weight": 0
                    },
                    "setup": "applications/application_mujoco_examples_ur10e/ur10e_corner_above_table.setup.json",
                    "reset": true
                }
            ]
        },
        {
            "group": "Contour following: run the 5 steps in order",
            "items": [
                {
                    "id": "contour1",
                    "title": "1. Move home (above the contour)",
                    "description": "Step 1/5 of the circular contour following demo of crospi (BeTFSM sequence).",
                    "task": "task_specifications/libraries/core_task_lib/task_specifications/move_jointspace_trap.etasl.lua",
                    "params": {
                        "maxacc": 0.2,
                        "maxvel": 0.5,
                        "target_joints": [-1.57, -1.5708, 2.0944, -2.0944, -1.5708, 0],
                        "units": "radians"
                    },
                    "setup": "applications/application_mujoco_examples_ur10e/ur10e_contour_following_circular.setup.json",
                    "reset": true
                },
                {
                    "id": "contour2",
                    "title": "2. Guarded motion down",
                    "description": "Step 2/5: down until contact with the table.",
                    "task": "task_specifications/libraries/force_control_task_lib/task_specifications/guarded_motion.etasl.lua",
                    "params": {
                        "force_threshold": 0.5,
                        "torque_threshold": 0.05,
                        "contact_forces": [0, 0, 3],
                        "force_monitor": 1,
                        "axis": "z",
                        "FT_sensor_frame": "FT_sensor_frame",
                        "guarded_motion_frame": "world_frame",
                        "K_F": [1500, 1500, 1500],
                        "K_T": [200, 200, 200],
                        "maxvel": 0.5,
                        "task_frame": "tcp_frame",
                        "tf_2_insframe": [0, 0, 0, 0, 0, 0, 1],
                        "time_delay": 2,
                        "tool_COG": [0, 0, 0],
                        "tool_weight": 0
                    },
                    "setup": "applications/application_mujoco_examples_ur10e/ur10e_contour_following_circular.setup.json"
                },
                {
                    "id": "contour3",
                    "title": "3. Move up 3 cm",
                    "description": "Step 3/5.",
                    "task": "task_specifications/libraries/core_task_lib/task_specifications/move_cartesianspace_relative.etasl.lua",
                    "params": {
                        "delta_euler": [0, 0, 0],
                        "delta_pos": [0, 0, 0.03],
                        "eq_r": 0.08,
                        "error_pos_th": 0.001,
                        "error_rot_th": 0.01,
                        "maxacc": 0.1,
                        "maxvel": 0.1,
                        "task_frame": "tcp_frame",
                        "wrt_frame": "world_frame"
                    },
                    "setup": "applications/application_mujoco_examples_ur10e/ur10e_contour_following_circular.setup.json"
                },
                {
                    "id": "contour4",
                    "title": "4. Guarded motion to the contour",
                    "description": "Step 4/5: along -x until contact with the contour.",
                    "task": "task_specifications/libraries/force_control_task_lib/task_specifications/guarded_motion.etasl.lua",
                    "params": {
                        "force_threshold": 0.5,
                        "torque_threshold": 0.05,
                        "contact_forces": [-5, 0, 0],
                        "force_monitor": 1,
                        "axis": "x",
                        "FT_sensor_frame": "FT_sensor_frame",
                        "guarded_motion_frame": "world_frame",
                        "K_F": [1500, 1500, 1500],
                        "K_T": [200, 200, 200],
                        "maxvel": 0.5,
                        "task_frame": "tcp_frame",
                        "tf_2_insframe": [0, 0, 0, 0, 0, 0, 1],
                        "time_delay": 2,
                        "tool_COG": [0, 0, 0],
                        "tool_weight": 0
                    },
                    "setup": "applications/application_mujoco_examples_ur10e/ur10e_contour_following_circular.setup.json"
                },
                {
                    "id": "contour5",
                    "title": "5. 2D contour following",
                    "description": "Step 5/5: follows the contour with a constant normal force (10 N).",
                    "task": "task_specifications/libraries/force_control_task_lib/task_specifications/2D_contour_following.etasl.lua",
                    "params": {
                        "task_frame": "tcp_frame",
                        "FT_sensor_frame": "FT_sensor_frame",
                        "tf_2_contact_frame": [0, 0, 0, 0, 0, 0, 1],
                        "wrench_convention": "exerted_on_environment",
                        "normal_force": 10,
                        "tangential_velocity": 0.03,
                        "ramp_up_time": 3,
                        "path_length": 1,
                        "contact_stiffness": 5000,
                        "K_force": 8,
                        "K_tracking": 1,
                        "K_hold": 4,
                        "tool_COG": [0, 0, 0],
                        "tool_weight": 0,
                        "filter_cutoff_frequency": 5,
                        "filter_order": 2
                    },
                    "setup": "applications/application_mujoco_examples_ur10e/ur10e_contour_following_circular.setup.json"
                }
            ]
        }
    ],
    "skill_examples": [
        {
            "group": "Force control",
            "items": [
                {
                    "id": "guarded",
                    "title": "Guarded motion sequence (loop)",
                    "script": "skill_specifications/libraries/skill_lib_example/guarded_motion_sequence/guarded_motion_sequence.py",
                    "setups": [
                        {"setup": "applications/application_mujoco_examples_ur10e/ur10e_guarded_motions.setup.json"}
                    ],
                    "description": "Repeat(Sequence(CrospiTask ...)): move home, approach the table, guarded motions along z, x and y."
                },
                {
                    "id": "circular",
                    "title": "Circular contour following",
                    "script": "skill_specifications/libraries/skill_lib_example/circular_contour_following_example/circular_contour_following_example.py",
                    "setups": [
                        {"setup": "applications/application_mujoco_examples_ur10e/ur10e_contour_following_circular.setup.json"}
                    ],
                    "description": "Move home, guarded motion down, move up, guarded motion to the contour, 2D contour following."
                },
                {
                    "id": "large_sine",
                    "title": "Large sine contour following",
                    "script": "skill_specifications/libraries/skill_lib_example/large_sine_contour_following_example/large_sine_contour_following_example.py",
                    "setups": [
                        {"setup": "applications/application_mujoco_examples_ur10e/ur10e_contour_following_large_sine.setup.json"}
                    ],
                    "description": "Contour following of a large sine-shaped contour."
                },
                {
                    "id": "L_shaped",
                    "title": "L-shaped contour following",
                    "script": "skill_specifications/libraries/skill_lib_example/L_shaped_contour_following_example/L_shaped_contour_following_example.py",
                    "setups": [
                        {"setup": "applications/application_mujoco_examples_ur10e/ur10e_contour_following_L_shaped.setup.json"}
                    ],
                    "description": "Contour following inside an L-shaped pocket (straight walls and rounded corners of different radii): move home, tare of the F/T sensor, guarded motions to the table and to the wall, then force-controlled contour following along 1.7 m of the wall. Set mode = SkillMode.FOLLOW_OUTER_CONTOUR in the skill to follow the outer face of the wall instead."
                },
                {
                    "id": "rectangular_peg_insertion",
                    "title": "Rectangular peg-in-hole insertion (gripper)",
                    "script": "skill_specifications/libraries/skill_lib_example/rectangular_peg_insertion/rectangular_peg_insertion.py",
                    "setups": [
                        {"setup": "applications/application_mujoco_examples_ur10e/ur10e_gripper_peg_insertion_rectangular_0.5mm.setup.json"},
                        {"setup": "applications/application_mujoco_examples_ur10e/ur10e_gripper_peg_insertion_rectangular_2mm.setup.json"},
                        {"setup": "applications/application_mujoco_examples_ur10e/ur10e_gripper_peg_insertion_rectangular_1mm.setup.json"},
                        {"setup": "applications/application_mujoco_examples_ur10e/ur10e_gripper_peg_insertion_rectangular_0.1mm.setup.json"}
                    ],
                    "description": "The UR10e picks a rectangular peg (30 x 20 mm) with its gripper from a known pose and inserts it in a hole with 0.5 mm of clearance (2, 1 and 0.1 mm: Setup dropdown of the Setup tab; set HOLE_CLEARANCE in the skill accordingly), following the methodology of Ulloa Rios et al., CASE 2026: initial placement with a known offset (translation and tilt) w.r.t. the hole, then a fixed sequence of insertion actions (insertion_action of force_control_task_lib) that reduce the offset one DoF at a time (z, y, x, theta_y, theta_z, theta_x) with force-controlled guarded motions, each finishing when its contact transition is detected, and a last push to the bottom. Change HOLE_POSE_ERROR in the skill to see that the exact pose of the hole is not needed."
                }
            ]
        },
        {
            "group": "Behavior trees and state machines",
            "items": [
                {
                    "id": "loop_fsm",
                    "title": "Loop with a TickingStateMachine",
                    "script": "skill_specifications/libraries/skill_lib_example/skill_example_loop_fsm/skill_example_loop_fsm.py",
                    "setups": [
                        {"setup": "applications/application_mujoco_examples_ur10e/ur10e_position_servo.setup.json"}
                    ],
                    "description": "State machine (TickingStateMachine) looping over joint, Cartesian and spline motions."
                },
                {
                    "id": "loop_bt",
                    "title": "Loop with a behavior-tree sequence",
                    "script": "skill_specifications/libraries/skill_lib_example/skill_example_loop_bt_sequence/skill_example_loop_bt_sequence.py",
                    "setups": [
                        {"setup": "applications/application_mujoco_examples_ur10e/ur10e_position_servo.setup.json"}
                    ],
                    "description": "The same loop written as a behavior-tree Sequence inside a Repeat."
                }
            ]
        },
        {
            "group": "Teleoperation",
            "items": [
                {
                    "id": "joystick",
                    "title": "Joystick teleoperation (SpaceMouse)",
                    "script": "skill_specifications/libraries/skill_lib_example/joystick_teleoperation/joystick_teleoperation.py",
                    "setups": [
                        {"setup": "applications/application_mujoco_examples_ur10e/ur10e_joystick_teleoperation.setup.json"},
                        {
                            "setup": "applications/application_mujoco_examples_franka_panda/franka_panda_joystick.setup.json",
